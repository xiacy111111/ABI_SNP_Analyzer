# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
ENV/
env/

# PyInstaller build artifacts
build/
dist/
*.spec.bak

# Executables (not version controlled — use GitHub Releases)
*.exe
*.msi

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~
~$*

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# pytest cache
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter Notebook
.ipynb_checkpoints/

# Environment
.env
.env.local

# Output data (generated at runtime)
output/
*.xlsx
*.csv
!data/*.csv

# Regenerated analysis outputs inside examples/ are not tracked
# (examples/ only carries the .ab1 input files)
examples/**/*.png
examples/**/*.fasta
examples/**/*.aln
examples/**/*.json

# Large data (reference genomes, external tools)
genome/
*.fna
*.fasta
*.fa
ncbi-blast-*/
muscle*.exe
blastn*.exe

